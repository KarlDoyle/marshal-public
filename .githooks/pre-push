#!/usr/bin/env bash
# Pre-push gate (Node) — the ai-starter standard.
#
# Runs CI's quality commands in the same order:
#   1. typecheck
#   2. lint
#   3. coverage-enforced tests (includes tests/secret-scan.test.ts)
#   4. build
# Blocks the push if any executed gate fails. Missing tools/dependencies skip
# the local gate as described below; CI installs dependencies and enforces it.
#
# Enabled via `git config core.hooksPath .githooks`, set automatically by the
# package.json `prepare` script on install.
#
# Skip in an emergency with `git push --no-verify`.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Pick a package manager that's actually installed.
if command -v pnpm >/dev/null 2>&1; then
  PM="pnpm"
elif command -v npm >/dev/null 2>&1; then
  PM="npm run"
else
  echo "pre-push: no pnpm/npm found — skipping local gate (CI still enforces)." >&2
  exit 0
fi

# Robust no-op: without installed deps the scripts can't run. Don't hard-block a
# fresh clone that hasn't installed yet — CI is the backstop.
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules missing — run install first; skipping gate." >&2
  exit 0
fi

echo "pre-push: typecheck + lint + coverage + build…"

if ! $PM typecheck; then
  echo "pre-push: typecheck failed — push aborted." >&2
  exit 1
fi

if ! $PM lint; then
  echo "pre-push: lint failed — push aborted." >&2
  exit 1
fi

if ! $PM coverage; then
  echo "pre-push: coverage-enforced tests failed — push aborted." >&2
  exit 1
fi

if ! $PM build; then
  echo "pre-push: build failed — push aborted." >&2
  exit 1
fi

echo "pre-push: OK."
