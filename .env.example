# Configuration reference. Export values in your shell, or copy to .env and use
# node --env-file=.env --experimental-sqlite dist/cli.js <command>.
# Marshal does not load .env automatically. NEVER commit real values.
# Everything has a sane local-first default; nothing here is required.

# Where Marshal stores per-repo indexes + the registry. Default: ~/.marshal
# MARSHAL_DATA_DIR=

# LLM provider for rewriting/triage. Default: ollama (localhost, no key).
# MARSHAL_PROVIDER=ollama
# MARSHAL_MODEL=llama3.1
# OLLAMA_HOST=http://127.0.0.1:11434
# A remote OLLAMA_HOST sends ticket text and retrieved code to that server.

# Optional: use the paid Anthropic API directly instead of Ollama (no fallback).
# Billed per token, separate from any Claude subscription — opt-in only.
# MARSHAL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional: live Jira fetch for `route`/`rewrite-ticket` when passing an issue
# KEY instead of a fixture file. Omit to stay fully offline with fixtures.
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_TOKEN=
